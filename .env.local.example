# Copy this file to .env.local and replace the placeholders. .env.local is
# ignored by Git. Rotate any key that has ever been pasted into chat or logs.
AWS_ACCESS_KEY_ID=replace-with-rotated-key
AWS_SECRET_ACCESS_KEY=replace-with-rotated-secret
AWS_REGION=us-west-1
S3_BUCKET=replace-with-your-bucket-name
S3_PREFIX=jewelry-product-scraper
# Only set this when media is served from a public CDN. Leave empty to use
# short-lived presigned URLs instead.
S3_PUBLIC_BASE_URL=

# Optional when the Mac is not using a system-wide VPN. A Chrome extension
# cannot route the background Scrapy process.
SCRAPER_PROXY_URL=

# Optional. run-local.command generates and prints a strong temporary token
# when this is left empty or omitted.
CONTROL_TOKEN=
